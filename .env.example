# Copy to .env.production before `docker compose -f docker-compose.prod.yml up`
#   cp .env.example .env.production

# App
NODE_ENV=production
PORT=3000
API_PREFIX=api
API_VERSION=v1
FRONTEND_URL=http://localhost
CORS_ORIGINS=http://localhost

# Host publish (localhost only — nginx of the VPS proxies 8085; DBeaver SSH tunnel uses 5435)
NGINX_PUBLISH=127.0.0.1:8085
POSTGRES_PUBLISH=127.0.0.1:5435

# Postgres (compose + Prisma)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=roomrentalad12ms!
POSTGRES_DB=room_rental
DATABASE_URL=postgresql://postgres:roomrentalad12ms!@postgres:5432/room_rental?schema=public
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth / JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
PASSWORD_RESET_EXPIRES_IN_MINUTES=60

# Storage
STORAGE_DRIVER=local
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=room-rental
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_PUBLIC_URL=http://localhost/uploads
STORAGE_LOCAL_PATH=./storage

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
THROTTLE_LOGIN_TTL=60
THROTTLE_LOGIN_LIMIT=5
PASSWORD_RESET_THROTTLE_TTL=3600
PASSWORD_RESET_THROTTLE_LIMIT=3
